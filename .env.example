# انسخ الملف ده باسم .env وحط قيمك فيه:  cp .env.example .env
# الملف .env مش بيترفع على git ومش بيظهر في الواجهة.

# مفتاح ElevenLabs (elevenlabs.io ← Developers ← API Keys)
ELEVENLABS_API_KEY=

# اختياري: ID صوت معيّن من أصواتك. لو فاضي، التجربة بتختار أول صوت من أصواتك.
ELEVENLABS_VOICE_ID=

# محرك الـ LLM: claude_code (اشتراك Claude عن طريق claude -p) أو anthropic_api
LLM_PROVIDER=claude_code

# مطلوب بس لو LLM_PROVIDER=anthropic_api. سيبه فاضي مع الاشتراك.
ANTHROPIC_API_KEY=
